#compdef armada-dev

_armada_dev() {
  local state
  _arguments -C \
    '(-h --help)'{-h,--help}'[show help]' \
    '--profile[docker-compose / procfile profile]:profile:(no-auth auth fake-executor)' \
    '--detach[run overmind in the background]' \
    '1: :->cmd'

  case "$state" in
    cmd)
      local -a cmds=(
        'up:start everything (deps + init + overmind daemonized)'
        'start:start overmind only (skips deps + init)'
        'down:stop everything, preserving data'
        'destroy:tear everything down (wipes Postgres data)'
        'deps:start docker-compose deps only'
        'init:run scripts/localdev-init.sh only'
        'ps:show all running armada-related resources'
      )
      _describe -t commands 'armada-dev command' cmds
      ;;
  esac
}

_armada_dev "$@"
