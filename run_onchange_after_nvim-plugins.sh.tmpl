#!/bin/bash
# Runs when init.lua changes
# init.lua hash: {{ include "dot_config/nvim/init.lua" | sha256sum }}

if command -v nvim &>/dev/null; then
    echo "Syncing Neovim plugins..."
    nvim --headless "+Lazy! sync" +qa 2>&1 || true
    nvim --headless "+TSUpdate" +qa 2>&1 || true
    echo "Re-adding lazy-lock.json to chezmoi source..."
    chezmoi re-add ~/.config/nvim/lazy-lock.json 2>&1 || true
fi
