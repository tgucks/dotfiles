#!/bin/bash
# Runs when any nvim Lua config file changes
# nvim config hash: {{ output "sh" "-c" (printf "find '%s/dot_config/nvim' -name '*.lua' -type f | sort | xargs cat | shasum -a 256" .chezmoi.sourceDir) | trim }}

if command -v nvim &>/dev/null; then
    echo "Syncing Neovim plugins..."
    nvim --headless "+Lazy! sync" +qa 2>&1 || true
    nvim --headless "+TSUpdate" +qa 2>&1 || true
    echo "Re-adding lazy-lock.json to chezmoi source..."
    chezmoi re-add ~/.config/nvim/lazy-lock.json 2>&1 || true
fi
