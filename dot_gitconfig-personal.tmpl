[user]
    name = {{ .gitName }}
    email = {{ .gitEmail }}

# Both accounts live at github.com, so the key - not the URL - decides which
# one you authenticate as. Rewrite to the github-personal Host alias from
# ~/.ssh/config, which pins the personal key.
# Applies to git clone too - the condition is evaluated against the
# destination gitdir, so cloning into one of these dirs is enough. The
# rewrite happens at connection time, so remote.origin.url stays github.com.
[url "git@github-personal:"]
    insteadOf = git@github.com:
