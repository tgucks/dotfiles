#!/bin/bash
# Merges managed settings into ~/.claude/settings.json
# Preserves keys that Claude sets at runtime (e.g., model)

DESIRED=$(cat <<'MANAGED'
{
  "autoUpdatesChannel": "latest",
  "cleanupPeriodDays": 180,
  "preferredNotifChannel": "notifications_disabled",
  "env": {
{{- if .claudeApiBaseUrl }}
    "ANTHROPIC_BASE_URL": {{ .claudeApiBaseUrl | toJson }}
{{- end }}
  },
{{- if eq .machineType "work" }}
  "apiKeyHelper": "~/.claude/claudecodeauth",
{{- end }}
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/fix-plugin-perms.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-session-track.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "zsh ~/.claude/statusline-command.sh"
  },
  "fileSuggestion": {
    "type": "command",
    "command": "bash ~/.claude/scripts/file-suggestion.sh"
  },
  "permissions": {
{{- if eq .machineType "work" }}
    "deny": [
      "WebSearch"
    ],
{{- end }}
    "allow": [
      "WebFetch",
{{- if ne .machineType "work" }}
      "WebSearch",
{{- end }}
      "Read",
      "Glob",
      "Grep",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "Bash(git blame:*)",
      "Bash(git check-ignore:*)",
      "Bash(git clone:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-tree:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git shortlog:*)",
      "Bash(git show:*)",
      "Bash(git show-ref:*)",
      "Bash(git status:*)",
      "Bash(git * blame:*)",
      "Bash(git * describe:*)",
      "Bash(git * diff:*)",
      "Bash(git * diff *)",
      "Bash(git * log:*)",
      "Bash(git * log *)",
      "Bash(git * ls-remote:*)",
      "Bash(git * merge-base:*)",
      "Bash(git * rev-list:*)",
      "Bash(git * rev-parse:*)",
      "Bash(git * shortlog:*)",
      "Bash(git * show:*)",
      "Bash(git * show *)",
      "Bash(git * show-ref:*)",
      "Bash(git * status:*)",
      "Bash(gh alias list:*)",
      "Bash(gh auth status:*)",
      "Bash(gh browse:*)",
      "Bash(gh cache list:*)",
      "Bash(gh cache view:*)",
      "Bash(gh codespace list:*)",
      "Bash(gh config get:*)",
      "Bash(gh config list:*)",
      "Bash(gh extension list:*)",
      "Bash(gh gist list:*)",
      "Bash(gh gist view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh ruleset list:*)",
      "Bash(gh ruleset view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh search:*)",
      "Bash(gh status:*)",
      "Bash(gh variable list:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(tail:*)",
      "Bash(pwd:*)",
      "Bash(head:*)"
{{- if eq .machineType "work" }},
      "mcp__atlas__getJiraIssue",
      "mcp__atlas__getConfluencePage",
      "mcp__atlas__getAccessibleAtlassianResources"
{{- end }}
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(git push:*)"
    ]
  }
}
MANAGED
)

CURRENT=$(cat)
if [[ -z "$CURRENT" || "$CURRENT" == "{}" ]]; then
  echo "$DESIRED"
  exit 0
fi

echo "$CURRENT" | jq --argjson desired "$DESIRED" '
  def deepmerge(a; b):
    a as $a | b as $b |
    if ($a | type) == "object" and ($b | type) == "object" then
      reduce ($b | keys[]) as $k ($a; .[$k] = deepmerge(.[$k]; $b[$k]))
    elif ($a | type) == "array" and ($b | type) == "array" then
      $b
    else $b end;
  deepmerge(.; $desired)
  | del(.hooks.PermissionRequest)
'
