[user]
    name = {{ .gitName }}
    email = {{ .gitEmail }}
{{ if eq .machineType "work" }}
[includeIf "gitdir:~/dotfiles/"]
    path = ~/.gitconfig-personal

[includeIf "gitdir:~/code/armada/"]
    path = ~/.gitconfig-personal

[includeIf "gitdir:~/code/armada-parent/"]
    path = ~/.gitconfig-personal

[includeIf "gitdir:~/code/personal/"]
    path = ~/.gitconfig-personal

[include]
    path = ~/.gitconfig-work
{{ end }}
[include]
    path = ~/dotfiles/git/gitconfig

[push]
    autoSetupRemote = true

[core]
    editor = nvim
