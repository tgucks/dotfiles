[alias]
  co = checkout
  lg = log --graph --date=human --pretty=format:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ad) %C(bold blue)<%an>%Creset'

[log]
  date = format-local:%Y-%m-%d %H:%M:%S %Z (UTC%z)

[core]
  pager = diff-so-fancy | less --tabs=4 -RF

[interactive]
  diffFilter = diff-so-fancy --patch

[color]
  ui = true

[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 22

[color "diff"]
  meta = 11
  frag = magenta bold
  func = 146 bold
  commit = yellow bold
  old = red bold
  new = green bold
  whitespace = red reverse
