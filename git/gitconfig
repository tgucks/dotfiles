[alias]
  co = checkout
  gf = fetch --all
  lg = log --graph --date=human --pretty=format:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ad) %C(bold blue)<%an>%Creset'

[log]
  date = format-local:%Y-%m-%d %H:%M:%S %Z (UTC%z)

[core]
  pager = command -v delta >/dev/null 2>&1 && delta || less

[interactive]
  diffFilter = command -v delta >/dev/null 2>&1 && delta --color-only || cat

[delta]
  navigate = true
  dark = true
  line-numbers = true
  side-by-side = true
  max-line-distance = 1.0

[merge]
  conflictStyle = zdiff3

[color]
  ui = true
