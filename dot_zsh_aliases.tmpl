# --- Git ---
alias gcm='git commit --message'
alias gap='git add --patch'
alias gl='git lg'
alias gpl='git pull'

# Open current GitHub repo directory in browser
ghopen() {
  local remote url subpath branch
  remote=$(git remote get-url origin 2>/dev/null) || { echo "Not a git repo or no origin remote"; return 1; }
  # Normalize SSH and HTTPS remote URLs to https://github.com/...
  url=$(echo "$remote" | sed -E 's|git@github\.com:|https://github.com/|; s|\.git$||')
  [[ "$url" != *github.com* ]] && { echo "Not a GitHub remote: $remote"; return 1; }
  subpath=$(git rev-parse --show-prefix 2>/dev/null)
  branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD)
{{ if eq .chezmoi.os "darwin" -}}
  open "${url}/tree/${branch}/${subpath%/}"
{{ else -}}
  xdg-open "${url}/tree/${branch}/${subpath%/}"
{{ end -}}
}

# --- use bat for help output ---
# Global aliases expand anywhere on the line, so -h is deliberately not one:
# it would rewrite `ls -h`, `sort -h`, `docker run -h host` and friends.
alias -g -- --help='--help 2>&1 | bat --language=help --style=plain'
alias bathelp='bat --plain --language=help'
help() {
    "$@" --help 2>&1 | bathelp
}
{{ if eq .chezmoi.os "darwin" -}}
alias man='batman'
{{ end -}}

# --- Claude ---
alias c=claude

clear-claude-plugin-cache() {
  local target="$HOME/.claude/plugins/cache"

  if [[ "$1" != "-y" ]]; then
    echo "Will delete: $target"
    read -q "?Continue? [y/N] " || { echo; return 0; }
    echo
  fi

  if rm -rf "$target"; then
    echo "Cleared $target"
  else
    echo "Failed to clear $target" >&2
    return 1
  fi
}

# --- OrbStack ---
orb-cleanup() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "docker not found. Is OrbStack installed?" >&2
    return 1
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "OrbStack not running?" >&2
    return 1
  fi

  echo "=== Current usage ==="
  docker system df
  echo

  echo "=== Stopped containers ==="
  docker ps -a --filter status=exited --filter status=created
  echo

  echo "=== Dangling images ==="
  docker images --filter dangling=true
  echo "(prune -af also removes unreferenced tagged images, not listed above)"
  echo

  echo "=== Unused volumes ==="
  docker volume ls --filter dangling=true
  echo

  read -q "?Proceed with aggressive cleanup (containers, all unused images, volumes, build cache)? [y/N] " \
    || { echo; echo "Cancelled."; return 0; }
  echo

  echo "Pruning stopped containers..."
  docker container prune -f
  echo "Pruning unused images..."
  docker image prune -af
  echo "Pruning unused volumes..."
  docker volume prune -af
  echo "Pruning build cache..."
  docker builder prune -af
  echo
  echo "=== After cleanup ==="
  docker system df
}

