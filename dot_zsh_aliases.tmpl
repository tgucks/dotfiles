# --- Aliases ---

# nvim wrapper: opt-in session restore via --resume / --continue.
# Plain `vim` / `v` opens a blank session; auto-session still saves on exit.
nvim() {
  local arg restore=0 args=()
  for arg in "$@"; do
    case "$arg" in
      --resume|--continue) restore=1 ;;
      *) args+=("$arg") ;;
    esac
  done
  if (( restore )); then
    command nvim "${args[@]}" "+AutoSession restore"
  else
    command nvim "${args[@]}"
  fi
}
alias vim=nvim
alias vi=nvim
alias v=nvim

# `nvim --embed` defers loading init.lua until an RPC client attaches a UI.
# When a spawner dies before its embed child (kill -9'd terminal, tmux pane
# torn down forcibly), the kernel reparents nvim to PID 1 and it sits there
# forever leaking memory waiting for an RPC peer that will never connect.
# Production has shown ~1 GB after ~40 hours per orphan. We sweep these in
# precmd so they never accumulate while a shell is open.
_nvim_etime_to_seconds() {
  emulate -L zsh
  local s="$1" days=0 hours=0 minutes=0 seconds=0
  if [[ "$s" == *-* ]]; then
    days="${s%%-*}"
    s="${s#*-}"
  fi
  local -a parts=("${(s/:/)s}")
  case "${#parts}" in
    3) hours="${parts[1]}"; minutes="${parts[2]}"; seconds="${parts[3]}" ;;
    2) minutes="${parts[1]}"; seconds="${parts[2]}" ;;
    1) seconds="${parts[1]}" ;;
  esac
  # 10# prefix forces base-10 to avoid octal interpretation of "08", "09".
  print $(( 10#$days * 86400 + 10#$hours * 3600 + 10#$minutes * 60 + 10#$seconds ))
}

_nvim_should_reap() {
  local ppid="$1" etime_secs="$2" grace="$3"
  [[ "$ppid" == "1" ]] || return 1
  (( etime_secs >= grace )) || return 1
  return 0
}

_nvim_reap_orphans() {
  emulate -L zsh
  local grace="${NVIM_REAPER_GRACE:-60}"
  local pid ppid etime secs
  for pid in ${(f)"$(pgrep -f 'nvim --embed' 2>/dev/null)"}; do
    [[ -z "$pid" ]] && continue
    ppid="$(ps -o ppid= -p $pid 2>/dev/null | tr -d ' ')"
    etime="$(ps -o etime= -p $pid 2>/dev/null | tr -d ' ')"
    [[ -z "$ppid" || -z "$etime" ]] && continue
    secs=$(_nvim_etime_to_seconds "$etime")
    _nvim_should_reap "$ppid" "$secs" "$grace" && kill -9 "$pid" 2>/dev/null
  done
}
# `&!` backgrounds and disowns; precmd returns immediately so the prompt is
# never blocked by pgrep/ps fork-exec cost (~20ms otherwise).
_nvim_reap_orphans_async() { _nvim_reap_orphans &! }
autoload -Uz add-zsh-hook
add-zsh-hook precmd _nvim_reap_orphans_async
