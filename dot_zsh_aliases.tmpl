# --- Git ---
alias gcm='git commit --message'
alias gap='git add --patch'
alias gl='git lg'
alias gpl='git pull'

# Open current GitHub repo directory in browser
ghopen() {
  local remote url subpath branch
  remote=$(git remote get-url origin 2>/dev/null) || { echo "Not a git repo or no origin remote"; return 1; }
  # Normalize SSH and HTTPS remote URLs to https://github.com/...
  url=$(echo "$remote" | sed -E 's|git@github\.com:|https://github.com/|; s|\.git$||')
  [[ "$url" != *github.com* ]] && { echo "Not a GitHub remote: $remote"; return 1; }
  subpath=$(git rev-parse --show-prefix 2>/dev/null)
  branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD)
{{ if eq .chezmoi.os "darwin" -}}
  open "${url}/tree/${branch}/${subpath%/}"
{{ else -}}
  xdg-open "${url}/tree/${branch}/${subpath%/}"
{{ end -}}
}

# --- use bat for help output ---
alias -g -- --help='--help 2>&1 | bat --language=help --style=plain'
alias -g -- -h='--help 2>&1 | bat --language=help --style=plain'
alias bathelp='bat --plain --language=help'
help() {
    "$@" --help 2>&1 | bathelp
}
{{ if eq .chezmoi.os "darwin" -}}
alias man='batman'
{{ end -}}

# --- Claude ---
alias c=claude

clear-claude-plugin-cache() {
  local target="$HOME/.claude/plugins/cache"

  if [[ "$1" != "-y" ]]; then
    echo "Will delete: $target"
    read -q "?Continue? [y/N] " || { echo; return 0; }
    echo
  fi

  if rm -rf "$target"; then
    echo "Cleared $target"
  else
    echo "Failed to clear $target" >&2
    return 1
  fi
}

