# --- Aliases ---

alias vim=nvim

# --- Git ---
alias gcm='git commit --message'
alias gap='git add --patch'

# --- use bat for help output ---
alias -g -- --help='--help 2>&1 | bat --language=help --style=plain'
alias -g -- -h='--help 2>&1 | bat --language=help --style=plain'
alias bathelp='bat --plain --language=help'
help() {
    "$@" --help 2>&1 | bathelp
}
alias man='batman'

# --- Claude ---
alias c=claude

claude() {
  local base=~/dotfiles/claude/settings.json
  local local_settings=~/.claude/settings.local.json
  local live=~/.claude/settings.json

  local files=()
  [[ -f "$live" ]] && files+=("$live")
  files+=("$base")
  [[ -f "$local_settings" ]] && files+=("$local_settings")

  jq -s '
    def deepmerge(a; b):
      a as $a | b as $b |
      if ($a | type) == "object" and ($b | type) == "object" then
        reduce ($b | keys[]) as $k ($a; .[$k] = deepmerge($a[$k]; $b[$k]))
      elif ($a | type) == "array" and ($b | type) == "array" then
        ($a + $b | unique)
      else $b end;
    reduce .[1:][] as $x (.[0]; deepmerge(.; $x))
  ' "${files[@]}" > "${live}.tmp" && mv "${live}.tmp" "$live"
  command claude "$@"
}
