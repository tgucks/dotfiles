# --- Custom spelling correction ---
# Replaces zsh's built-in CORRECT with persistent always/never support.
# Choices at the prompt:
#   y  yes (once)
#   n  no (once)
#   a  always correct this way (saved as alias)
#   e  n[e]ver correct this command again (saved, applied via nocorrect alias)
#
# Corrections are persisted in ~/.zsh_corrections (not tracked in dotfiles).

_ZSH_CORRECT_FILE="$HOME/.zsh_corrections"
[[ -f "$_ZSH_CORRECT_FILE" ]] || touch "$_ZSH_CORRECT_FILE"

# Replay persisted corrections as aliases on shell start
function _zsh_load_corrections() {
  local type word correction
  while IFS=: read -r type word correction; do
    [[ -z "$type" || "$type" == \#* ]] && continue
    case "$type" in
      never)  alias "$word"="nocorrect $word" ;;
      always) alias "$word"="$correction" ;;
    esac
  done < "$_ZSH_CORRECT_FILE"
}
_zsh_load_corrections

# Find the closest command using character-level comparison (handles 1-2 char typos)
function _zsh_suggest_cmd() {
  local word="$1" cmd best="" best_score=999 score i
  local lw=${#word}
  for cmd in ${(k)commands}; do
    local lc=${#cmd}
    (( lw - lc > 2 || lc - lw > 2 )) && continue
    score=0
    local max=$(( lw > lc ? lw : lc ))
    for (( i = 1; i <= max; i++ )); do
      [[ "${word[i]}" != "${cmd[i]}" ]] && (( score++ ))
    done
    if (( score > 0 && score < best_score && score <= 2 )); then
      best_score=$score
      best="$cmd"
    fi
  done
  print -- "$best"
}

# Override accept-line to intercept unknown commands before execution
function _zsh_correct_accept_line() {
  local cmd="${${(z)BUFFER}[1]}"

  # Skip if empty, is a path, or resolves to anything known
  if [[ -z "$cmd" || "$cmd" == */* ]] || \
     [[ "$(whence -w "$cmd" 2>/dev/null)" != *": not found" ]]; then
    zle .accept-line
    return
  fi

  local suggestion="$(_zsh_suggest_cmd "$cmd")"
  if [[ -z "$suggestion" ]]; then
    zle .accept-line
    return
  fi

  zle -R "zsh: correct '$cmd' to '$suggestion'? [y]es  [n]o  [a]lways  n[e]ver "
  local key
  read -k1 key
  zle -R ""
  print

  case "$key" in
    y)
      BUFFER="${suggestion}${BUFFER#$cmd}"
      ;;
    a)
      BUFFER="${suggestion}${BUFFER#$cmd}"
      print "always:${cmd}:${suggestion}" >> "$_ZSH_CORRECT_FILE"
      alias "$cmd"="$suggestion"
      ;;
    e)
      print "never:${cmd}:" >> "$_ZSH_CORRECT_FILE"
      alias "$cmd"="nocorrect $cmd"
      ;;
  esac

  zle .accept-line
}
zle -N accept-line _zsh_correct_accept_line
